# Binance.US API keys (only needed for live mode)
# Paper mode uses public market data, no key required
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Notion integration token (for Quant journal writes)
NOTION_TOKEN=

# Alpaca market data keys (backtest data downloads only)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_ENDPOINT=

# FRED market data key (macro series downloads)
FRED_API_KEY=

# Trading database
TRADING_DB_PATH=db/trading.db

# Live mode acknowledgment (must be set to go live)
# Both config.yaml mode=live AND this env var must be set
TRADING_LIVE_ACK=
