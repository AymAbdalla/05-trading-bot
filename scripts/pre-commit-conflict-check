#!/bin/bash
# aym-trading-bot conflict-check hook v1 -- THE REAL LOGIC.
#
# Installed as .git/hooks/pre-commit by scripts/install_conflict_hook.sh, which
# writes a tiny shim that execs THIS file. The logic lives here, under version
# control, so it is reviewable and diffable. .git/hooks is not.
#
# The shim's only job is `exec "$ROOT/scripts/pre-commit-conflict-check"`, so a
# behaviour change in this file is live with NO reinstall (verified by reading
# the installed shim, not assumed). The "v1" marker in install_conflict_hook.sh
# identifies the SHIM, not this policy, and is deliberately NOT bumped for a
# logic change: bumping it would make the already-installed shim fail that
# script's `is_ours` test and get backed up as a stranger's hook.
#
# TWO HOOKS, ONE SCRIPT. The job is chosen by argv, not by a copy of this file:
#   no argument  -> pre-commit  mode: steps 1-3 below.
#   a file path  -> commit-msg  mode: step 4 only, on the message git composed.
# The trailer CANNOT be checked from pre-commit; the step 4 comment has the
# measurement that says why. Install both shims with install_conflict_hook.sh.
#
# WHAT IT DOES
#   1. Reports active checkouts from engine.concurrency.who_is_editing().
#      WARNS ONLY. An agent may legitimately have finished without checkin, and
#      a hook that blocked on that would be trained around within a day.
#   2. Verifies every staged file's hash against what the coordination table
#      says the last coordinated write produced. THIS refuses.
#   3. Verifies that the staged files are YOURS, where "yours" means the last
#      HASH-CHANGING coordinated write is yours (D-337). THIS refuses too.
#   4. Verifies the commit message carries `Agent-Id: <resolved identity>` when
#      an identity resolved at all (D-335). THIS refuses. No identity, no
#      requirement -- a human interactive commit is untouched.
#
# WHY STEP 3 EXISTS (convention 16 enforcement)
#   Twice in two nights an agent ran `git add -A`, swept another session's
#   ledger-written files into its own commit, and wrote a commit message that
#   mentioned none of them (b1d44bb, then 4d03681). Step 2 passed both times
#   and was RIGHT to: the staged hash did match the ledger. The ledger knew the
#   content was coordinated. It did not check that the coordinating agent and
#   the committing agent were the same one. That gap is this step.
#
#   It happened a THIRD time on 2026-08-19 (26555f2), through this very hook.
#   Step 3 asks the ledger who owns a path, and the ledger takes appends from
#   anyone: the sweeping session recorded `write` rows carrying the hash the
#   files already had, became their owner, and the question answered itself.
#   D-337 is the answer -- see the ownership note above resolve_owner. A write
#   that changed nothing no longer takes ownership of anything.
#
#   So a commit has to be able to say WHO it is. The commit author cannot carry
#   that: every commit in this repo is authored `Aym Abdalla` from repo git
#   config, agent and human alike. Identity is therefore DECLARED through the
#   environment, and an undeclared session staging another agent's file is
#   refused rather than assumed innocent. The declaration is unverifiable by
#   construction and is printed as such -- it raises the cost of this mistake
#   from zero to one deliberate keystroke, which is the whole goal. It is not
#   a security boundary and must never be described as one.
#
# WHAT IT DOES NOT DO
#   It never writes to the tree, never stages, never unstages, never touches a
#   running process. It opens db/trading.db for SELECT only.
#
# CONVENTION 11 / 20: every staged file lands in exactly ONE category, in BOTH
# classifications (step 2: verified / untracked-by-coordination / MISMATCH /
# unreadable; step 3: own-work / FOREIGN-OWNED / no-agent-owner /
# owner-unknown), both are counted and printed, and BOTH accounting identities
# are asserted. A silent `continue` in either loop would be a missing number.
#
# CONVENTION 14: python runs as `env -u PYTHONPATH python3`. Hermes leaks its
# 3.11 venv onto PYTHONPATH and imports then fail in ways that look like a
# broken install.
#
# RUN IT STANDALONE (this is the testable path, not a claim in a docstring):
#     scripts/pre-commit-conflict-check
#     SKIP_CONFLICT_CHECK=1 scripts/pre-commit-conflict-check
#     CONFLICT_CHECK_DB=/tmp/x.db scripts/pre-commit-conflict-check
#     CONFLICT_CHECK_AGENT_ID=cody-foo scripts/pre-commit-conflict-check
#     CONFLICT_CHECK_ALLOW_SWEEP=1 scripts/pre-commit-conflict-check
#     scripts/pre-commit-conflict-check /path/to/a/commit/message   # step 4
#
# ENVIRONMENT
#   SKIP_CONFLICT_CHECK=1       bypass entirely, loudly
#   CONFLICT_CHECK_DB           override the coordination database path
#   CONFLICT_CHECK_MAX_AGE      active-checkout window in seconds (default 3600)
#   CONFLICT_CHECK_AGENT_ID     declare the committing agent. Falls back to
#                               AGENT_ID then TRADING_BOT_AGENT_ID -- the SAME
#                               variables engine.concurrency reads for
#                               DEFAULT_AGENT_ID, so a session that already
#                               exports one is already declared. It never falls
#                               back to that module's literal 'cody' default:
#                               an undeclared session is undeclared, and saying
#                               otherwise would be a lie.
#   GIT_AUTHOR_NAME             accepted as a declaration ONLY when it names an
#                               agent, because git sets it on every commit. Set
#                               it without an environment prefix using
#                               `git commit --author="cody-foo <cody@x>"`, which
#                               also records the identity in git history.
#   CONFLICT_CHECK_ALLOW_SWEEP  1/true/yes/on -- downgrade a cross-owner refusal
#                               to a loud, itemised warning. This is how a
#                               reconcile-style session legitimately lands a
#                               dead session's work. It is never silent, and a
#                               value that is set but unrecognised is reported.
#
# EXIT CODES
#   0  allowed (verified, or could-not-verify, or bypassed, or declared sweep)
#   1  REFUSED: a staged file changed outside the coordination module, and/or a
#      staged file belongs to another agent and the sweep was not declared,
#      and/or (commit-msg mode) the Agent-Id trailer is missing or mismatched
set -euo pipefail

if [ "${SKIP_CONFLICT_CHECK:-0}" = "1" ]; then
  echo "conflict-check: BYPASSED via SKIP_CONFLICT_CHECK=1."
  echo "conflict-check: nothing was verified. This is a bypass, not a pass."
  exit 0
fi

# Work from the repo root so the hook behaves identically no matter which
# subdirectory git invoked it from.
if ! HOOK_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "conflict-check: WARNING -- not inside a git work tree; check COULD NOT RUN."
  echo "conflict-check: allowing."
  exit 0
fi
cd "$HOOK_REPO_ROOT"
export HOOK_REPO_ROOT

if ! command -v python3 >/dev/null 2>&1; then
  echo "conflict-check: WARNING -- python3 not found; check COULD NOT RUN."
  echo "conflict-check: allowing."
  exit 0
fi

exec env -u PYTHONPATH python3 - "$@" <<'PYCODE'
"""Staged-file hash AND provenance verification against engine.concurrency."""

from __future__ import annotations

import hashlib
import os
import sqlite3
import subprocess
import sys

# --------------------------------------------------------------------------
# Policy constants. Module level, never inline literals.
# --------------------------------------------------------------------------

#: git's canonical empty tree, for the unborn-branch (first commit) case.
EMPTY_TREE = '4b825dc642cb6eb9a060e54bf8d69288fbee4904'

#: SQLite caps host parameters per statement. Chunk well under it.
SQL_CHUNK = 400

#: Only these actions record "the module wrote this content".
COORDINATED_WRITE_ACTIONS = ('checkin', 'write')

#: How many rows of each category to print before truncating.
MAX_LISTED = 40

DEFAULT_MAX_AGE_SEC = 3600.0
SQLITE_BUSY_TIMEOUT_MS = 5000
SQLITE_CONNECT_TIMEOUT_SEC = 15.0

VERIFIED = 'verified'
UNTRACKED = 'untracked-by-coordination'
MISMATCH = 'MISMATCH'
UNREADABLE = 'unreadable'
CATEGORIES = (VERIFIED, UNTRACKED, MISMATCH, UNREADABLE)

#: Step 3's buckets. Same accounting discipline as CATEGORIES above.
OWN = 'own-work'
FOREIGN = 'FOREIGN-OWNED'
NOT_AGENT = 'no-agent-owner'
OWNER_UNKNOWN = 'owner-unknown'
OWNER_CATEGORIES = (OWN, FOREIGN, NOT_AGENT, OWNER_UNKNOWN)

#: Where the committing session declares itself, in resolution order. The last
#: two are engine.concurrency's own DEFAULT_AGENT_ID inputs, on purpose: one
#: identity, one place to set it, no second parallel mechanism to keep in sync.
AGENT_ID_ENV_VARS = ('CONFLICT_CHECK_AGENT_ID', 'AGENT_ID',
                     'TRADING_BOT_AGENT_ID')

#: Last-resort identity source, and the only one that needs no `VAR=x` prefix
#: on the commit itself -- `git commit --author="cody-foo <...>"` is enough, and
#: git exports this to the hook. That matters because a spawned agent session
#: cannot always set an environment prefix on a single command, and a mechanism
#: its own agents cannot reach is not a mechanism.
#:
#: It is honoured ONLY when the value is agent-shaped. git sets this variable on
#: EVERY commit, falling back to user.name, so accepting it unconditionally
#: would turn every one of Aym's commits into a "declaration" of `Aym Abdalla`
#: and quietly retire the NOT DECLARED state this step depends on.
#:
#: Bonus over the env vars: --author lands the identity in git history, so the
#: provenance outlives the hook run that checked it.
GIT_AUTHOR_ENV = 'GIT_AUTHOR_NAME'

#: An agent_id is a KNOWN NON-HUMAN owner when it equals one of these or starts
#: with one followed by a separator. All 43 distinct agent_ids in
#: db/trading.db today match 'cody' or 'raven'; the others are here so a future
#: agent family is covered by default rather than silently exempt.
#:
#: Deliberately a WHITELIST of agent shapes rather than a blacklist of human
#: ones. The rule is "refuse on a KNOWN non-human owner", so anything this hook
#: does not recognise -- a human id, a hand-written id, no ledger row at all --
#: falls to NOT_AGENT and nothing changes for it. That is what keeps Aym's own
#: commits working exactly as they did before step 3 existed.
AGENT_ID_PREFIXES = ('cody', 'raven', 'forge', 'hermes', 'claude', 'agent')
AGENT_ID_SEPARATORS = ('-', '_', '.', ':', '/')

SWEEP_ESCAPE_ENV = 'CONFLICT_CHECK_ALLOW_SWEEP'
SWEEP_ESCAPE_TRUE = ('1', 'true', 'yes', 'on')

ROOT = os.environ.get('HOOK_REPO_ROOT') or os.getcwd()
DB_PATH = os.environ.get('CONFLICT_CHECK_DB') or os.path.join(
    ROOT, 'db', 'trading.db')
try:
    MAX_AGE_SEC = float(os.environ.get('CONFLICT_CHECK_MAX_AGE',
                                       DEFAULT_MAX_AGE_SEC))
except ValueError:
    MAX_AGE_SEC = DEFAULT_MAX_AGE_SEC

BYPASS_NOTE = (
    'To commit anyway: `SKIP_CONFLICT_CHECK=1 git commit ...` or '
    '`git commit --no-verify`. Both are bypasses, not passes.')


def say(msg=''):
    sys.stdout.write(msg + '\n')


def rule(char='-'):
    say(char * 72)


def short(digest):
    return digest[:12] if digest else 'none'


# --------------------------------------------------------------------------
# Declared identity
# --------------------------------------------------------------------------

def declared_identity():
    """(identity, source_env_var). Both None when nothing was declared.

    No fallback to a login name, and none to engine.concurrency's literal
    'cody' default. The entire point of step 3 is telling "this is mine" apart
    from "nobody said", so a default would erase the distinction it exists to
    draw.
    """
    for var in AGENT_ID_ENV_VARS:
        raw = os.environ.get(var)
        if raw is None:
            continue
        value = raw.strip()
        if value:
            return value, var
    # git always exports this, so it is accepted only when it names an agent.
    # See GIT_AUTHOR_ENV for why that condition is load-bearing.
    author = (os.environ.get(GIT_AUTHOR_ENV) or '').strip()
    if author and is_agent_owner(author):
        return author, GIT_AUTHOR_ENV
    return None, None


def sweep_escape_state():
    """(armed, raw). armed=False with a non-empty raw means SET BUT UNREAD.

    A typo'd escape that behaved silently like "not set" would produce a
    refusal the committer believed they had already answered, so it is
    reported rather than swallowed (convention 20's spirit: no silent branch).
    """
    raw = os.environ.get(SWEEP_ESCAPE_ENV)
    if raw is None:
        return False, None
    return raw.strip().lower() in SWEEP_ESCAPE_TRUE, raw


def is_agent_owner(agent_id):
    """True when agent_id is a KNOWN non-human agent identity."""
    if not agent_id:
        return False
    value = str(agent_id).strip().lower()
    if not value:
        return False
    for prefix in AGENT_ID_PREFIXES:
        if value == prefix:
            return True
        nxt = value[len(prefix):len(prefix) + 1]
        if value.startswith(prefix) and nxt in AGENT_ID_SEPARATORS:
            return True
    return False


def same_identity(a, b):
    if a is None or b is None:
        return False
    return str(a).strip().lower() == str(b).strip().lower()


DECLARED_ID, DECLARED_SRC = declared_identity()
SWEEP_ARMED, SWEEP_RAW = sweep_escape_state()


# --------------------------------------------------------------------------
# git plumbing
# --------------------------------------------------------------------------

def git(args, binary=False):
    """Run git at the repo root. Returns (ok, out). Never raises."""
    try:
        proc = subprocess.run(['git'] + list(args), cwd=ROOT,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as exc:
        return False, ('git unavailable: %s' % exc).encode('utf-8')
    if proc.returncode != 0:
        return False, proc.stderr
    return True, proc.stdout if binary else proc.stdout.decode(
        'utf-8', 'replace')


def has_head():
    ok, _ = git(['rev-parse', '--verify', '--quiet', 'HEAD'])
    return ok


def staged_paths():
    """Repo-relative POSIX paths staged as Added/Copied/Modified.

    Returns (ok, paths). Deletions are excluded on purpose: a deleted file has
    no content to hash, and refusing a deletion because its hash "changed"
    would be nonsense.
    """
    args = ['diff', '--cached', '--name-only', '--diff-filter=ACM', '-z']
    if not has_head():
        args.append(EMPTY_TREE)
    ok, out = git(args, binary=True)
    if not ok:
        return False, []
    return True, [p.decode('utf-8', 'replace')
                  for p in out.split(b'\0') if p]


def index_blobs():
    """path -> staged blob sha1 (stage 0 only), plus the set of unmerged paths.

    Read from `git ls-files -s -z` rather than by handing each path back to git
    as a pathspec: a filename containing a glob character would otherwise be
    re-interpreted as a pattern.
    """
    ok, out = git(['ls-files', '-s', '-z'], binary=True)
    if not ok:
        return None, None
    blobs, unmerged = {}, set()
    for rec in out.split(b'\0'):
        if not rec:
            continue
        try:
            meta, path = rec.split(b'\t', 1)
            _mode, sha, stage = meta.split()
        except ValueError:
            continue
        name = path.decode('utf-8', 'replace')
        if stage == b'0':
            blobs[name] = sha.decode('ascii')
        else:
            unmerged.add(name)
    return blobs, unmerged


def staged_blob_hash(sha1):
    """SHA-256 of the STAGED bytes, fetched by object id via git cat-file."""
    ok, out = git(['cat-file', 'blob', sha1], binary=True)
    if not ok:
        return None, out.decode('utf-8', 'replace').strip()
    return hashlib.sha256(out).hexdigest(), None


# --------------------------------------------------------------------------
# engine.concurrency
# --------------------------------------------------------------------------

if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

CONCURRENCY_OK = True
CONCURRENCY_ERR = ''
try:
    from engine.concurrency import (  # noqa: E402
        who_is_editing, hash_file, rel_path, format_active, LOG_FAILURES)
except Exception as exc:                                  # noqa: BLE001
    CONCURRENCY_OK = False
    CONCURRENCY_ERR = '%s: %s' % (type(exc).__name__, exc)

    def rel_path(p):                                      # type: ignore
        return os.path.relpath(os.path.abspath(p), ROOT).replace(os.sep, '/')

    def hash_file(p):                                     # type: ignore
        try:
            with open(p, 'rb') as fh:
                return hashlib.sha256(fh.read()).hexdigest()
        except FileNotFoundError:
            return None

    LOG_FAILURES = {}                                     # type: ignore


def coordination_keys(git_path):
    """Every table key this staged path might be recorded under.

    `rel_path` is the normalisation the table uses, but it resolves symlinks,
    so on a machine where the repo root is reached through one it can differ
    from git's own path. Look up BOTH rather than silently missing a row and
    calling a tracked file untracked.
    """
    keys = [git_path]
    if CONCURRENCY_OK:
        try:
            alt = rel_path(os.path.join(ROOT, git_path))
            if alt and alt not in keys:
                keys.append(alt)
        except Exception:                                 # noqa: BLE001
            pass
    return keys


# --------------------------------------------------------------------------
# The coordination table
# --------------------------------------------------------------------------

#: Step 3 ownership resolution (D-337). A coordinated write whose new_hash
#: equals the previous coordinated write's new_hash for the same path CHANGED
#: NOTHING. It is recorded as provenance -- somebody did run the module -- but
#: it does NOT transfer ownership.
#:
#: WHY. At 03:16 on 2026-08-19 a session recorded `write` rows over four files
#: it had not authored, carrying the hash those files ALREADY had, became their
#: ledger owner, and swept them into commit 26555f2 whose message names none of
#: them. Step 3 asks the ledger who owns a path; the ledger is append-only and
#: anybody may append to it; so the party being checked could author the very
#: evidence that clears it. No bypass flag was needed or used. That is the hole.
#:
#: The fix is READ-SIDE ONLY. The ledger stays append-only and every row it ever
#: had is still there -- what changed is which row step 3 believes. Step 2 is
#: deliberately untouched: the expected content is still the NEWEST row's
#: new_hash, and hash-identical rows agree on that by construction, so not one
#: hash verdict moves.
#:
#: This raises the cost of the sweep from "append a row" to "append a row that
#: changes the file", which is an edit somebody has to write and justify. Like
#: the rest of step 3 it is a COST, not a security boundary.


def resolve_owner(rows):
    """(owner_row, neutral_skipped) for ONE path's ascending write rows.

    Walks backwards from the newest row, skipping every row that recorded the
    same new_hash as its predecessor. Ownership lands on the most recent
    HASH-CHANGING write. When every row for a path is hash-identical nothing
    ever changed the file after the first write, so ownership stays with the
    EARLIEST writer -- the one who actually put that content there.

    A row that recorded NO new_hash at all is ownership-neutral too, and this
    goes one step beyond D-337(1) as Raven wrote it. The ruling says to skip a
    row whose new_hash EQUALS its predecessor's; a NULL hash equals nothing, so
    the literal rule would let a null-hash restamp take ownership -- and it is
    strictly cheaper than the sweep D-337 exists to stop, because a null hash
    ALSO drops the path out of step 2's verified bucket into
    untracked-by-coordination. A row carrying no content cannot be evidence of
    authoring content. Flagged for Raven to ratify or strike; pinned by
    test_rows_recording_no_hash_are_ownership_neutral_too.

    Nothing legitimate is lost either way: this can only ever hand ownership
    BACKWARDS to an earlier writer, never to a later one, so it cannot be used
    to claim a path.
    """
    index = len(rows) - 1
    skipped = 0
    while index > 0 and (rows[index][0] is None
                         or rows[index][0] == rows[index - 1][0]):
        index -= 1
        skipped += 1
    return rows[index], skipped


def last_coordinated_writes(keys):
    """key -> (new_hash, action, ts, agent_id, owner_action, neutral_skipped).

    The first two fields describe the NEWEST checkin/write, which is what step
    2 verifies staged content against. `ts`, `agent_id` and `owner_action`
    describe the OWNING write, which is the newest HASH-CHANGING one (see
    resolve_owner and the D-337 note above). They are the same row whenever the
    newest write actually changed something, which is the ordinary case.

    Returns (rows, error). `error` non-None means the table COULD NOT BE READ,
    which is emphatically not the same fact as "no rows exist" (convention 11).
    """
    if not os.path.exists(DB_PATH):
        return None, 'coordination database not found at %s' % DB_PATH
    try:
        conn = sqlite3.connect(DB_PATH, timeout=SQLITE_CONNECT_TIMEOUT_SEC)
        conn.execute('PRAGMA busy_timeout=%d;' % SQLITE_BUSY_TIMEOUT_MS)
    except sqlite3.Error as exc:
        return None, 'cannot open %s (%s)' % (DB_PATH, exc)

    history = {}
    try:
        exists = conn.execute(
            "SELECT name FROM sqlite_master WHERE type='table' "
            "AND name='file_coordination'").fetchone()
        if not exists:
            return None, ('table file_coordination does not exist in %s '
                          '(nothing has ever been written through the module)'
                          % DB_PATH)
        ordered = sorted(keys)
        marks = ','.join('?' * len(COORDINATED_WRITE_ACTIONS))
        for i in range(0, len(ordered), SQL_CHUNK):
            chunk = ordered[i:i + SQL_CHUNK]
            sql = ('SELECT file_path, new_hash, action, ts, agent_id, id '
                   'FROM file_coordination '
                   'WHERE action IN (%s) AND file_path IN (%s) '
                   'ORDER BY ts ASC, id ASC'
                   % (marks, ','.join('?' * len(chunk))))
            for row in conn.execute(
                    sql, tuple(COORDINATED_WRITE_ACTIONS) + tuple(chunk)):
                # ORDER BY ascending, so this appends in write order. The
                # WHOLE history is kept rather than just the newest row:
                # ownership is decided by walking it (D-337), and a query that
                # remembered only the last row could not tell a real edit from
                # a hash-identical restamp by a passer-by.
                history.setdefault(row[0], []).append(
                    (row[1], row[2], row[3], row[4]))
    except sqlite3.Error as exc:
        return None, 'query failed on %s (%s)' % (DB_PATH, exc)
    finally:
        try:
            conn.close()
        except sqlite3.Error:
            pass

    latest = {}
    for key, rows in history.items():
        newest_hash, newest_action = rows[-1][0], rows[-1][1]
        owner_row, skipped = resolve_owner(rows)
        latest[key] = (newest_hash, newest_action, owner_row[2], owner_row[3],
                       owner_row[1], skipped)
    return latest, None


# --------------------------------------------------------------------------
# Step 1: active checkouts. WARN ONLY.
# --------------------------------------------------------------------------

def report_active_checkouts():
    """Returns True if the report ran, False if it could not."""
    say('[1/3] active checkouts (advisory, never blocking)')
    if not CONCURRENCY_OK:
        say('      COULD NOT RUN: engine.concurrency did not import (%s)'
            % CONCURRENCY_ERR)
        return False
    if not os.path.exists(DB_PATH):
        say('      COULD NOT RUN: no coordination database at %s' % DB_PATH)
        return False
    try:
        active = who_is_editing(db_path=DB_PATH, max_age_sec=MAX_AGE_SEC)
    except Exception as exc:                              # noqa: BLE001
        say('      COULD NOT RUN: who_is_editing raised %s: %s'
            % (type(exc).__name__, exc))
        return False

    if LOG_FAILURES:
        say('      WARNING: coordination log degraded %s -- this list '
            'UNDER-reports.' % dict(LOG_FAILURES))
    if not active:
        say('      none in the last %.0fs.' % MAX_AGE_SEC)
        return True

    say('      %d open checkout(s) in the last %.0fs. This is a WARNING, not a '
        'refusal:' % (len(active), MAX_AGE_SEC))
    say('      an agent may have finished without calling checkin().')
    say(format_active(active[:MAX_LISTED]))
    if len(active) > MAX_LISTED:
        say('      ... and %d more' % (len(active) - MAX_LISTED))
    return True


# --------------------------------------------------------------------------
# Step 2: staged-file hash verification. THIS can refuse.
# --------------------------------------------------------------------------

class Finding(object):
    __slots__ = ('path', 'category', 'expected', 'staged', 'worktree',
                 'source', 'note', 'owner', 'owner_ts', 'owner_known',
                 'neutral_skipped')

    def __init__(self, path, category, expected=None, staged=None,
                 worktree=None, source='staged blob', note='',
                 owner=None, owner_ts=None, owner_known=False,
                 neutral_skipped=0):
        self.path = path
        self.category = category
        self.expected = expected
        self.staged = staged
        self.worktree = worktree
        self.source = source
        self.note = note
        #: agent_id on the most recent coordinated write, or None.
        self.owner = owner
        self.owner_ts = owner_ts
        #: False means the table could not be consulted for this path, which is
        #: not the same fact as "this path has no owner" (convention 11).
        self.owner_known = owner_known
        #: How many hash-neutral rows D-337 walked past to reach that owner.
        #: Non-zero means somebody restamped this path without changing it, so
        #: the newest ledger row and the OWNER are different rows. Printed, not
        #: swallowed: a silent walk-back would be a missing number.
        self.neutral_skipped = neutral_skipped


def provenance_note(action, owner_action, owner, skipped):
    """One sentence naming the owning write, and any walk-back that found it.

    When `skipped` is zero this reads exactly as it did before D-337, because
    nothing was skipped and the newest row IS the owner. When it is not zero,
    saying "last coordinated write by <owner>" would be false -- the last write
    was by somebody else and changed nothing -- so the note says both.
    """
    if not skipped:
        return 'last coordinated %s by %s' % (action, owner)
    return ('last coordinated %s recorded no change; owner is the last '
            'hash-changing %s, by %s (%d hash-neutral row(s) skipped, D-337)'
            % (action, owner_action, owner, skipped))


def classify(paths, blobs, unmerged, latest, table_error):
    """Exactly one Finding per staged path. No path may fall through."""
    findings = []
    for path in paths:
        # Resolve ownership FIRST, before any early exit, so every Finding
        # carries an owner verdict no matter which step-2 branch it lands in.
        # An unmerged or unreadable path still has a ledger owner, and step 3
        # still has to account for it.
        owner, owner_ts, owner_known = None, None, False
        expected, action = None, None
        owner_action, skipped = None, 0
        if table_error is None:
            owner_known = True
            for key in coordination_keys(path):
                hit = latest.get(key)
                if hit is not None:
                    (expected, action, owner_ts, owner,
                     owner_action, skipped) = hit
                    break

        def make(category, **kw):
            return Finding(path, category, owner=owner, owner_ts=owner_ts,
                           owner_known=owner_known, neutral_skipped=skipped,
                           **kw)

        if path in unmerged:
            findings.append(make(
                UNREADABLE, note='unmerged in the index (stage != 0); '
                                 'resolve the merge first'))
            continue

        sha1 = blobs.get(path)
        if sha1 is None:
            findings.append(make(
                UNREADABLE,
                note='staged but absent from `git ls-files -s` at stage 0'))
            continue

        staged, err = staged_blob_hash(sha1)
        if staged is None:
            findings.append(make(
                UNREADABLE,
                note='could not read staged blob %s (%s)' % (sha1[:12], err)))
            continue

        try:
            worktree = hash_file(os.path.join(ROOT, path))
        except Exception as exc:                          # noqa: BLE001
            worktree = None
            wt_note = ' worktree unreadable (%s)' % type(exc).__name__
        else:
            wt_note = ''

        if table_error is not None:
            # The table could not be read. Calling these files
            # "untracked-by-coordination" would let COULD NOT VERIFY read as
            # VERIFIED. It is unreadable, and it says so.
            findings.append(make(
                UNREADABLE, staged=staged, worktree=worktree,
                note='coordination table unreadable' + wt_note))
            continue

        if expected is None:
            note = ('never written through engine.concurrency'
                    if action is None else
                    'last %s row recorded no new_hash; ledger owner is %s'
                    % (action, owner))
            findings.append(make(UNTRACKED, staged=staged,
                                 worktree=worktree, note=note + wt_note))
        elif expected == staged:
            note = provenance_note(action, owner_action, owner, skipped)
            if worktree is not None and worktree != staged:
                note += ('; NOTE worktree differs from the staged blob '
                         '(%s) -- the staged content is what was verified'
                         % short(worktree))
            findings.append(make(VERIFIED, expected=expected,
                                 staged=staged, worktree=worktree,
                                 note=note + wt_note))
        else:
            note = ('%s at ts=%s'
                    % (provenance_note(action, owner_action, owner, skipped),
                       owner_ts))
            if worktree is not None and worktree == expected:
                note += ('; the WORKTREE still matches -- it is the STAGED '
                         'content that was never coordinated')
            findings.append(make(MISMATCH, expected=expected,
                                 staged=staged, worktree=worktree,
                                 note=note + wt_note))
    return findings


def report(findings, total):
    counts = dict((c, 0) for c in CATEGORIES)
    for f in findings:
        counts[f.category] += 1

    for cat in (MISMATCH, UNREADABLE, UNTRACKED, VERIFIED):
        rows = [f for f in findings if f.category == cat]
        if not rows:
            continue
        say('      %s (%d):' % (cat, len(rows)))
        for f in rows[:MAX_LISTED]:
            if cat == MISMATCH:
                say('        %s' % f.path)
                say('          %-34s : %s'
                    % ('expected, last coordinated write', f.expected))
                say('          %-34s : %s'
                    % ('found, in the %s' % f.source.upper(), f.staged))
                if f.worktree != f.staged:
                    say('          %-34s : %s'
                        % ('worktree file right now',
                           f.worktree or 'DOES NOT EXIST'))
                say('          %s' % f.note)
            elif cat == VERIFIED:
                say('        %s  %s (%s)' % (short(f.staged), f.path, f.note))
            else:
                say('        %s  %s' % (f.path, f.note))
        if len(rows) > MAX_LISTED:
            say('        ... and %d more' % (len(rows) - MAX_LISTED))

    total_counted = sum(counts.values())
    say()
    say('      summary: total=%d  %s=%d  %s=%d  %s=%d  %s=%d'
        % (total, VERIFIED, counts[VERIFIED], UNTRACKED, counts[UNTRACKED],
           MISMATCH, counts[MISMATCH], UNREADABLE, counts[UNREADABLE]))

    # Convention 20: the accounting identity is asserted, not assumed.
    if total_counted != total:
        say()
        say('conflict-check: INTERNAL ERROR -- accounting identity violated: '
            '%d staged files but %d classified. Refusing rather than reporting '
            'a number that does not add up.' % (total, total_counted))
        say('conflict-check: ' + BYPASS_NOTE)
        sys.exit(1)
    assert total_counted == total
    return counts


# --------------------------------------------------------------------------
# Step 3: provenance. Is this file YOURS? THIS can refuse.
# --------------------------------------------------------------------------

def ownership(finding):
    """Exactly one OWNER_CATEGORIES bucket per Finding."""
    if not finding.owner_known:
        return OWNER_UNKNOWN
    if not is_agent_owner(finding.owner):
        # No ledger row at all, or an owner this hook does not recognise as an
        # agent. A human commit over human-owned or unowned paths behaves
        # exactly as it did before step 3 existed.
        return NOT_AGENT
    if same_identity(finding.owner, DECLARED_ID):
        return OWN
    return FOREIGN


def report_provenance(findings, total):
    """Print the ownership classification. Returns its counts."""
    say('[3/3] staged-file provenance (this step can REFUSE)')

    if DECLARED_ID is None:
        say('      committing identity: NOT DECLARED')
        say('        declare one by setting %s.'
            % ' or '.join(AGENT_ID_ENV_VARS))
    else:
        say('      committing identity: %s   (declared via %s; UNVERIFIED -- '
            'the hook cannot check that a declaration is true)'
            % (DECLARED_ID, DECLARED_SRC))

    if SWEEP_RAW is not None and not SWEEP_ARMED:
        say('      WARNING: %s is set to %r, which is NOT one of %s. The sweep '
            'escape is NOT armed.'
            % (SWEEP_ESCAPE_ENV, SWEEP_RAW, '/'.join(SWEEP_ESCAPE_TRUE)))
    elif SWEEP_ARMED:
        say('      sweep escape: ARMED (%s=%s). Cross-owner paths will be '
            'allowed and listed, not refused.' % (SWEEP_ESCAPE_ENV, SWEEP_RAW))

    buckets = dict((c, []) for c in OWNER_CATEGORIES)
    for f in findings:
        buckets[ownership(f)].append(f)

    for cat in (FOREIGN, OWNER_UNKNOWN, OWN, NOT_AGENT):
        rows = buckets[cat]
        if not rows:
            continue
        say('      %s (%d):' % (cat, len(rows)))
        for f in rows[:MAX_LISTED]:
            if cat == FOREIGN:
                say('        %s' % f.path)
                say('          %-24s : %s' % ('ledger owner', f.owner))
                say('          %-24s : %s'
                    % ('committing identity',
                       DECLARED_ID if DECLARED_ID else 'NOT DECLARED'))
                say('          %-24s : %s'
                    % ('owner wrote it at ts', f.owner_ts))
                if f.neutral_skipped:
                    say('          %-24s : %d row(s) walked past to reach '
                        'that owner (D-337); a later write recorded this '
                        'path unchanged and did not take it.'
                        % ('hash-neutral rows', f.neutral_skipped))
            elif cat == OWN:
                say('        %s  (ledger owner %s == declared)'
                    % (f.path, f.owner))
            elif cat == OWNER_UNKNOWN:
                say('        %s  (the coordination table could not be '
                    'consulted)' % f.path)
            else:
                say('        %s  (ledger owner %s)'
                    % (f.path, f.owner if f.owner else 'none'))
        if len(rows) > MAX_LISTED:
            say('        ... and %d more' % (len(rows) - MAX_LISTED))

    counts = dict((c, len(buckets[c])) for c in OWNER_CATEGORIES)
    total_counted = sum(counts.values())
    say()
    say('      summary: total=%d  %s=%d  %s=%d  %s=%d  %s=%d'
        % (total, OWN, counts[OWN], FOREIGN, counts[FOREIGN],
           NOT_AGENT, counts[NOT_AGENT], OWNER_UNKNOWN,
           counts[OWNER_UNKNOWN]))

    # Convention 20 again. Two classifications, two identities, both checked.
    if total_counted != total:
        say()
        say('conflict-check: INTERNAL ERROR -- provenance accounting identity '
            'violated: %d staged files but %d classified. Refusing rather than '
            'reporting a number that does not add up.'
            % (total, total_counted))
        say('conflict-check: ' + BYPASS_NOTE)
        sys.exit(1)
    assert total_counted == total
    return counts


def say_sweep_refusal(count):
    rule('!')
    say('conflict-check: REFUSED. %d staged file(s) were last written through '
        'engine.concurrency by a DIFFERENT agent.' % count)
    say('')
    if DECLARED_ID is None:
        say('This session declared no identity, so the hook cannot tell '
            'whether that work is yours. Convention 16: never `git add -A`. '
            'Three times in three nights a sweep like this carried another '
            'session\'s files into a commit whose message never mentioned '
            'them (b1d44bb, 4d03681, 26555f2).')
    else:
        say('This session declared itself "%s", which is not the agent that '
            'wrote those files. Convention 16: never `git add -A`. Three times '
            'in three nights a sweep like this carried another session\'s '
            'files into a commit whose message never mentioned them (b1d44bb, '
            '4d03681, 26555f2).' % DECLARED_ID)
    say('')
    say('What to do, in order of preference:')
    say('  1. Commit only your own paths, with a pathspec (convention 34).')
    say('     It stages exactly those paths and leaves another session\'s '
        'staged entries untouched, which `git restore --staged` does not:')
    say('       git commit -m "..." -- <your path> [<your path> ...]')
    say('     Or unstage what is not yours, per path listed above:')
    say('       git restore --staged <path>')
    say('  2. If it IS your work, declare the identity that wrote it:')
    say('       CONFLICT_CHECK_AGENT_ID=<the ledger owner> git commit ...')
    say('     or, if you cannot set an environment prefix (spawned sessions '
        'often cannot), declare it as the git author instead:')
    say('       git commit --author="<the ledger owner> <cody@agents.invalid>"')
    say('     Note: recording a coordinated write over a file you did not '
        'change does NOT make it yours. A hash-neutral write is ownership-'
        'neutral (D-337); it is how 26555f2 happened.')
    say('  3. If you are deliberately landing a dead session\'s work (a '
        'reconcile sweep), declare the sweep. It is allowed, and every swept '
        'path gets listed:')
    say('       %s=1 git commit ...' % SWEEP_ESCAPE_ENV)
    say('')
    say('Do NOT reach for SKIP_CONFLICT_CHECK or --no-verify here. Option 3 '
        'lands the same commit and leaves a record of what was swept.')
    say('')
    say('conflict-check: ' + BYPASS_NOTE)
    rule('!')


def say_sweep_warning(findings):
    rows = [f for f in findings if ownership(f) == FOREIGN]
    rule('!')
    say('conflict-check: SWEEP DECLARED (%s=%s). Allowing %d cross-owner '
        'file(s). This is a declared exception, not a clean commit:'
        % (SWEEP_ESCAPE_ENV, SWEEP_RAW, len(rows)))
    for f in rows[:MAX_LISTED]:
        say('    %-58s  owner=%s' % (f.path, f.owner))
    if len(rows) > MAX_LISTED:
        say('    ... and %d more' % (len(rows) - MAX_LISTED))
    say('')
    say('Convention 31: make the commit message say it is landing other '
        'sessions\' work, and name it. A sweep whose message mentions none of '
        'these paths is exactly how b1d44bb and 4d03681 happened.')
    rule('!')


# --------------------------------------------------------------------------
# Step 4: the Agent-Id commit trailer (D-335). THIS can refuse.
#
# WHY THIS RUNS AS commit-msg AND NOT AS pre-commit
#   D-335 says to read "the commit message in progress (.git/COMMIT_EDITMSG)".
#   MEASURED 2026-08-19, three commits into a throwaway repo, hook printing
#   that file: <NO FILE>, then "FIRST MESSAGE", then "SECOND MESSAGE". At
#   pre-commit time the file still holds the PREVIOUS commit message, because
#   git composes the new one AFTER pre-commit returns.
#
#   Verifying it there would gate every commit on its predecessor: the first
#   agent commit is refused for a message written before the rule existed, and
#   every commit following a correct one passes no matter what it says. That is
#   an off-by-one gate, which is worse than no gate -- it reports PASS about the
#   wrong object. Convention 33: a gate its own agents cannot satisfy honestly
#   gets bypassed, and one that passes for the wrong reason gets trusted.
#
#   git hands the commit-msg hook the composed message file as $1. So this one
#   script serves both hooks and picks its job from argv: a message path means
#   "verify the trailer", no argument means "verify hashes and provenance".
#   Total coverage per commit is identical; nothing is checked twice.
# --------------------------------------------------------------------------

#: The trailer key D-335(1) requires. Matched case-insensitively, per git.
TRAILER_KEY = 'Agent-Id'


def message_path():
    """The commit-msg file git handed us, or None in pre-commit mode."""
    for arg in sys.argv[1:]:
        value = arg.strip()
        if value:
            return value if os.path.isabs(value) else os.path.join(ROOT, value)
    return None


def parse_trailers(path):
    """(trailers, error) -- [(key, value)] in file order, or a read failure.

    Delegated to `git interpret-trailers --parse` rather than hand-rolled.
    Trailer semantics (last paragraph only, `#` comment lines ignored, folded
    continuations) are git's definition; a second implementation here would be
    a second thing to keep in sync, and it would drift.

    A git failure returns an ERROR, never an empty list. "could not read the
    message" is not the fact "the message has no trailer" (convention 11), and
    conflating them would refuse a correct commit for an unrelated reason.
    """
    ok, out = git(['interpret-trailers', '--parse', path])
    if not ok:
        detail = out.decode('utf-8', 'replace') if isinstance(out, bytes) \
            else str(out)
        return None, detail.strip() or 'git interpret-trailers failed'
    trailers = []
    for line in out.splitlines():
        if ':' not in line:
            continue
        key, value = line.split(':', 1)
        trailers.append((key.strip(), value.strip()))
    return trailers, None


def say_trailer_refusal(reason, found):
    """Name the sanctioned path (convention 33), not just the violation."""
    rule('!')
    say('conflict-check: REFUSED. %s' % reason)
    say('')
    say('D-335: every commit from a spawned session records WHO made it, in '
        'the commit object itself. The hook checks the declaration at commit '
        'time and then the terminal is discarded; without a trailer nothing '
        'machine-readable survives into history.')
    say('')
    if found:
        say('This message carries: %s'
            % ', '.join('%s: %s' % (k, v) for k, v in found))
        say('')
    say('The sanctioned path: end the commit message with a blank line and '
        'then, as its own last paragraph:')
    say('')
    say('    %s: %s' % (TRAILER_KEY, DECLARED_ID))
    say('')
    say('It must be the LAST paragraph and it must be on its own line, or git '
        'does not parse it as a trailer. Check before committing with:')
    say('    git interpret-trailers --parse <message-file>')
    say('')
    say('If %s is not who you are, fix the identity rather than the trailer: '
        'it was declared via %s.' % (DECLARED_ID, DECLARED_SRC))
    say('')
    say('conflict-check: ' + BYPASS_NOTE)
    rule('!')


def verify_trailer(path):
    """Step 4, the whole of commit-msg mode. Returns an exit code."""
    say()
    rule('=')
    say('conflict-check  commit message trailer (D-335)')
    say('repo: %s' % ROOT)
    say('as:   %s' % (DECLARED_ID if DECLARED_ID else 'UNDECLARED identity'))
    say('msg:  %s' % path)
    rule('=')
    say('[trailer] %s must match the resolved identity (this can REFUSE)'
        % TRAILER_KEY)

    if DECLARED_ID is None:
        say('      committing identity: NOT DECLARED, so no trailer is '
            'required.')
        say('      D-335(2) gates on a RESOLVED identity only; a human '
            'interactive commit is unchanged.')
        say()
        say('conflict-check: OK (no identity declared, nothing to verify).')
        rule()
        return 0

    say('      committing identity: %s   (declared via %s)'
        % (DECLARED_ID, DECLARED_SRC))

    if not os.path.exists(path):
        say('      COULD NOT RUN: no message file at %s' % path)
        say()
        say('conflict-check: WARNING -- the trailer check COULD NOT RUN, so '
            'NOTHING was verified. Allowing the commit.')
        rule()
        return 0

    trailers, error = parse_trailers(path)
    if error is not None:
        say('      COULD NOT RUN: %s' % error)
        say()
        say('conflict-check: WARNING -- the trailer check COULD NOT RUN, so '
            'NOTHING was verified. Allowing the commit.')
        rule()
        return 0

    matches = [(k, v) for k, v in trailers
               if k.strip().lower() == TRAILER_KEY.lower()]
    say('      trailers parsed: %d  (%s: %d)'
        % (len(trailers), TRAILER_KEY, len(matches)))

    if not matches:
        say()
        say_trailer_refusal(
            'the commit message carries no %s trailer, but this session '
            'resolved the identity "%s".' % (TRAILER_KEY, DECLARED_ID),
            trailers)
        return 1

    distinct = sorted(set(v.strip().lower() for _k, v in matches))
    wrong = [v for v in distinct if not same_identity(v, DECLARED_ID)]
    if wrong:
        say()
        say_trailer_refusal(
            '%s says %s, but this session resolved the identity "%s".'
            % (TRAILER_KEY, ' and '.join(repr(v) for v in distinct),
               DECLARED_ID),
            matches)
        return 1

    say()
    say('conflict-check: OK. %s: %s matches the resolved identity.'
        % (TRAILER_KEY, DECLARED_ID))
    rule()
    return 0


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def main():
    # argv decides the job. git gives commit-msg the message file and
    # pre-commit nothing at all, so one script covers both hooks and neither
    # repeats the other's work. See the step 4 comment for why the trailer
    # cannot be checked from pre-commit.
    msg = message_path()
    if msg is not None:
        return verify_trailer(msg)

    say()
    rule('=')
    say('conflict-check  (engine.concurrency, conventions 16 / 21)')
    say('repo: %s' % ROOT)
    say('db:   %s' % DB_PATH)
    say('as:   %s' % (DECLARED_ID if DECLARED_ID else 'UNDECLARED identity'))
    say('note: the %s trailer (D-335) is verified by the commit-msg hook, not '
        'here -- at' % TRAILER_KEY)
    say('      pre-commit time .git/COMMIT_EDITMSG is still the PREVIOUS '
        'message. Install both')
    say('      hooks with scripts/install_conflict_hook.sh, or that check '
        'never runs.')
    rule('=')

    degraded = not report_active_checkouts()
    say()

    say('[2/3] staged-file hash verification (this step can REFUSE)')
    ok, paths = staged_paths()
    if not ok:
        say('      COULD NOT RUN: `git diff --cached` failed.')
        say()
        say('conflict-check: WARNING -- the check COULD NOT RUN. Nothing was '
            'verified. Allowing the commit.')
        return 0
    if not paths:
        say('      nothing staged. summary: total=0  %s=0  %s=0  %s=0  %s=0'
            % CATEGORIES)
        say()
        say('conflict-check: OK (nothing to verify).')
        return 0

    blobs, unmerged = index_blobs()
    if blobs is None:
        say('      COULD NOT RUN: `git ls-files -s` failed.')
        say()
        say('conflict-check: WARNING -- the check COULD NOT RUN. Nothing was '
            'verified. Allowing the commit.')
        return 0

    keys = []
    for p in paths:
        keys.extend(coordination_keys(p))
    latest, table_error = last_coordinated_writes(sorted(set(keys)))
    if table_error is not None:
        latest = {}
        degraded = True
        say('      WARNING: %s' % table_error)

    findings = classify(paths, blobs, unmerged, latest, table_error)
    counts = report(findings, len(paths))

    say()
    owner_counts = report_provenance(findings, len(paths))

    say()
    if LOG_FAILURES:
        degraded = True
        say('conflict-check: WARNING -- the coordination log is degraded %s. '
            'Rows may be MISSING, so "%s" may be overstated.'
            % (dict(LOG_FAILURES), UNTRACKED))

    # Both refusals are decided before either is printed, so a commit that
    # trips both is told about both rather than fixing one and rediscovering
    # the other on the next attempt.
    refuse_hash = counts[MISMATCH] > 0
    refuse_sweep = owner_counts[FOREIGN] > 0 and not SWEEP_ARMED

    if refuse_hash:
        rule('!')
        say('conflict-check: REFUSED. %d staged file(s) changed after the last '
            'write that went through engine.concurrency.' % counts[MISMATCH])
        say('')
        say('That means somebody wrote them OUTSIDE the module -- a plain '
            'open(), an editor, a Write/Edit tool, or another agent session. '
            'Convention 21: this tree is shared. Possibly you are about to '
            'commit over another session\'s work.')
        say('')
        say('What to do: read the file, reconcile the two versions by hand, '
            'then re-write it through engine.concurrency (safe_write / '
            'safe_edit / checkout+checkin) and re-stage it.')
        say('')
        say('conflict-check: ' + BYPASS_NOTE)
        rule('!')

    if refuse_sweep:
        if refuse_hash:
            say()
        say_sweep_refusal(owner_counts[FOREIGN])
    elif owner_counts[FOREIGN]:
        say_sweep_warning(findings)

    if refuse_hash or refuse_sweep:
        return 1

    if table_error is not None:
        say('conflict-check: WARNING -- the check COULD NOT RUN against the '
            'coordination table, so NOTHING was verified. %d staged file(s) '
            'were classified "%s". Allowing the commit.'
            % (counts[UNREADABLE], UNREADABLE))
        rule()
        return 0

    if counts[UNREADABLE]:
        say('conflict-check: WARNING -- %d staged file(s) could not be read '
            'and were NOT verified. Allowing the commit, but "could not '
            'verify" is not "verified".' % counts[UNREADABLE])

    say('conflict-check: OK. %d verified, %d untracked-by-coordination, '
        '%d own-work, %d not-agent-owned%s.'
        % (counts[VERIFIED], counts[UNTRACKED], owner_counts[OWN],
           owner_counts[NOT_AGENT],
           ' (report degraded)' if degraded else ''))
    rule()
    return 0


if __name__ == '__main__':
    sys.exit(main())
PYCODE
